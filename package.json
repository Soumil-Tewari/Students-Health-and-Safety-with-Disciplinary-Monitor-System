{
  "name": "student-health-safety-discipline",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:production": "npm run build && npm start",
    "dev": "node --watch src/server.js",
    "dev:all": "node scripts/dev.cjs",
    "render:build": "npm ci && npm --prefix frontend ci --include=dev && npm --prefix frontend run build",
    "create-admin": "node src/createAdmin.js",
    "seed": "node src/seedData.js",
    "build": "npm --prefix frontend ci --include=dev && npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
    ,"pg": "^8.13.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}